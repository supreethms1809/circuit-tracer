{
  "defaults": [
    "../macag/default.json",
    "../benchmarks/neurips_core_local.json"
  ],
  "suite_name": "neurips_core_gpt2_local",
  "description": "Local Mac-friendly variant of the core NeurIPS suite. Reduced batch sizes, fewer tokens, shorter training, and float32 for CPU/MPS debugging. Not for final results -- use neurips_core_gpt2.json on GH200.",
  "output_root": "results/paper_local",
  "seeds": [101],
  "stages": {
    "collect_dataset": true,
    "train": true,
    "evaluate": true,
    "macag": true,
    "report": true
  },
  "dataset": {
    "model_name": "gpt2",
    "dataset_name": "ssuresh/codelion_all-5B",
    "dataset_config": "",
    "n_tokens": 50000,
    "seq_len": 128,
    "batch_size": 16,
    "cache_dir": "shared/activations",
    "max_train_samples": 300,
    "eval_samples": 50,
    "dtype": "bfloat16",
    "device": null,
    "seed": 17
  },
  "evaluation": {
    "graph": {
      "max_features": 32,
      "max_n_logits": 6,
      "desired_logit_prob": 0.9,
      "node_threshold": 0.8,
      "edge_threshold": 0.98,
      "attribution_batch_size": 4
    },
    "circuit": {
      "top_k_features": 8,
      "alpha": 0.5,
      "run_shapley": true,
      "shapley_samples": 16
    },
    "monosemanticity": {
      "enabled": true,
      "n_features": 50,
      "top_k_examples": 5,
      "n_samples": 50
    },
    "splines": {
      "enabled": true,
      "n_features": 10,
      "top_dims": 3,
      "n_samples": 50,
      "no_plot": true
    }
  },
  "model_variants": {
    "spline_default_gpt2": {
      "label": "Spline-CLT",
      "model_name": "gpt2",
      "scan_id": "spline-clt-gpt2",
      "training": {
        "n_layers": 12,
        "d_model": 768,
        "d_transcoder": 4096,
        "encoder_type": "kan",
        "grid_size": 5,
        "spline_order": 3,
        "learning_rate": 0.0001,
        "warmup_steps": 500,
        "total_steps": 5000,
        "batch_size": 4,
        "lambda_sparsity": 0.05,
        "c_sparsity": 1.0,
        "grad_clip": 1.0,
        "log_every": 100,
        "eval_every": 100,
        "save_every": 10000,
        "update_grid_every": 200,
        "update_grid_from": 50,
        "reset_optimizer_every": 0,
        "val_fraction": 0.05,
        "dtype": "bfloat16",
        "device": null,
        "run_name": "spline_clt_gpt2"
      }
    },
    "linear_param_match_gpt2": {
      "label": "Linear CLT (param-match)",
      "model_name": "gpt2",
      "scan_id": "linear-param-gpt2",
      "training": {
        "n_layers": 12,
        "d_model": 768,
        "d_transcoder": 9216,
        "encoder_type": "linear",
        "grid_size": 5,
        "spline_order": 3,
        "learning_rate": 0.0001,
        "warmup_steps": 500,
        "total_steps": 5000,
        "batch_size": 8,
        "lambda_sparsity": 0.05,
        "c_sparsity": 1.0,
        "grad_clip": 1.0,
        "log_every": 100,
        "eval_every": 100,
        "save_every": 10000,
        "update_grid_every": 0,
        "update_grid_from": 0,
        "reset_optimizer_every": 0,
        "val_fraction": 0.05,
        "dtype": "bfloat16",
        "device": null,
        "run_name": "linear_param_gpt2"
      }
    },
    "linear_feature_match_gpt2": {
      "label": "Linear CLT (feature-match)",
      "model_name": "gpt2",
      "scan_id": "linear-feature-gpt2",
      "training": {
        "n_layers": 12,
        "d_model": 768,
        "d_transcoder": 4096,
        "encoder_type": "linear",
        "grid_size": 5,
        "spline_order": 3,
        "learning_rate": 0.0001,
        "warmup_steps": 500,
        "total_steps": 5000,
        "batch_size": 4,
        "lambda_sparsity": 0.05,
        "c_sparsity": 1.0,
        "grad_clip": 1.0,
        "log_every": 100,
        "eval_every": 100,
        "save_every": 10000,
        "update_grid_every": 0,
        "update_grid_from": 0,
        "reset_optimizer_every": 0,
        "val_fraction": 0.05,
        "dtype": "bfloat16",
        "device": null,
        "run_name": "linear_feature_gpt2"
      }
    },
    "spline_param_target_gpt2": {
      "label": "Spline-CLT (param-target)",
      "model_name": "gpt2",
      "scan_id": "spline-param-target-gpt2",
      "training": {
        "n_layers": 12,
        "d_model": 768,
        "d_transcoder": 1862,
        "encoder_type": "kan",
        "grid_size": 5,
        "spline_order": 3,
        "learning_rate": 0.0001,
        "warmup_steps": 500,
        "total_steps": 5000,
        "batch_size": 8,
        "lambda_sparsity": 0.05,
        "c_sparsity": 1.0,
        "grad_clip": 1.0,
        "log_every": 100,
        "eval_every": 100,
        "save_every": 10000,
        "update_grid_every": 200,
        "update_grid_from": 50,
        "reset_optimizer_every": 0,
        "val_fraction": 0.05,
        "dtype": "bfloat16",
        "device": null,
        "run_name": "spline_param_target_gpt2"
      }
    }
  },
  "reporting": {
    "primary_variant": "spline_default_gpt2",
    "baseline_variant": "linear_param_match_gpt2",
    "bootstrap_samples": 100,
    "confidence_level": 0.95,
    "figure_case_study_prompt_id": "ioi_john_mary"
  }
}
