{
  "defaults": [
    "../base/common_gpt2_small.json",
    "../macag/default.json",
    "../models/r2_gpt2_small_spline_feature_match.json",
    "../benchmarks/neurips_core.json"
  ],
  "suite_name": "paper_r4_gpt2_small_spline_feature_match",
  "description": "R4: r3 spline FM (data_scaled decoder init) + lambda_sparsity 0.005 -> 1e-5. Full KAN encoder. Single seed.",
  "seeds": [
    101
  ],
  "stages": {
    "report": false
  },
  "dataset": {
    "n_tokens": 750000000,
    "cache_dir": "/lscratch/paper_r4/gpt2_small_spline_feature_match/train",
