  },
  "model_variants": {
    "gpt2_small_spline_feature_match_r2": {
      "training": {
        "use_fsdp": true,
        "resume_training_if_exists": true,
        "fsdp_cpu_offload": false,
        "decoder_init_strategy": "data_scaled",
        "decoder_calibration_samples": 16,
        "lambda_sparsity": 1e-05,
        "sparsity_warmup_steps": 2000,
        "sparsity_decay_start": 14000,
        "lambda_sparsity_final": 3e-6
      }
    }
  },
  "reporting": {
    "primary_variant": "gpt2_small_spline_feature_match_r2",
    "baseline_variant": "gpt2_small_spline_feature_match_r2"
  }
}
