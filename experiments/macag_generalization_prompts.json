    {"slug": "chicago-springfield",  "city": "Chicago",      "target": " Springfield", "foil": " Illinois"},
    {"slug": "miami-tallahassee",    "city": "Miami",        "target": " Tallahassee", "foil": " Florida"},
    {"slug": "detroit-lansing",      "city": "Detroit",      "target": " Lansing",     "foil": " Michigan"},
    {"slug": "portland-salem",       "city": "Portland",     "target": " Salem",       "foil": " Oregon"},
    {"slug": "cleveland-columbus",   "city": "Cleveland",    "target": " Columbus",    "foil": " Ohio"},
